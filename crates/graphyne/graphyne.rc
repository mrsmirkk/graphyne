// Windows resources: icon 1 is the exe icon and (loaded by gpui) every window's icon.
#include <winver.h>

1 ICON "graphyne.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Graphyne"
            VALUE "FileDescription", "Graphyne IDE"
            VALUE "FileVersion", VER_STRING
            VALUE "InternalName", "graphyne"
            VALUE "OriginalFilename", "graphyne.exe"
            VALUE "ProductName", "Graphyne"
            VALUE "ProductVersion", VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
